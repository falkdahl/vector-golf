    "dialogs": [
        {
            "t": 1600,
            "speaker": "May",
            "text": "Thanks for helping with this Caddy.",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-may.png",
            "portraitSide": "left",
            "name": "may 1",
            "duration": 2000,
            "texts": [
                "Thanks for helping with this Caddy.",
                "It would be impossible to beat the legendary courses of Mt. Aeolus without you."
            ],
            "gaps": [
                1500
            ]
        },
        {
            "t": 12500,
            "speaker": "Caddy",
            "text": "Save your breath, kid.",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-caddy.png",
            "portraitSide": "left",
            "texts": [
                "Save your breath, kid.",
                "I’ve been lugging bags up these rocks for forty years. Nobody clears this course.",
                "The Grandmaster claims he did a 9-hole run once, but it's a rigged game. He cheated, I tell you!",
                "It's physically impossible!"
            ],
            "gaps": [
                1500,
                1500,
                500
            ],
            "duration": 1500
        },
        {
            "t": null,
            "speaker": "May",
            "text": " I don't care how hard it is. I'm May. ",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-may.png",
            "portraitSide": "left",
            "auto": true,
            "texts": [
                " I don't care how hard it is. I'm May. ",
                "I want to see how good I really am, and I'm going to the top."
            ],
            "gaps": [
                1000
            ],
            "duration": 1500
        },
        {
            "t": 36200,
            "speaker": "Caddy",
            "text": "Dream all you want kid.",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-caddy.png",
            "portraitSide": "left",
            "duration": 1000,
            "texts": [
                "Dream all you want kid.",
                "I'm in as long as the pay checks keep coming."
            ],
            "gaps": [
                1000
            ]
        },
        {
            "t": 45000,
            "speaker": "???",
            "text": "You seek to conquer Mt. Aeolus, young one?",
            "cps": 20,
            "duration": 1000
        },
        {
            "t": 48500,
            "speaker": "May",
            "text": "Who's there?!",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-may.png",
            "portraitSide": "left",
            "duration": 1000
        },
        {
            "t": 53100,
            "speaker": "???",
            "text": "The wind up here does not just blow.\n",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-rat.png",
            "portraitSide": "left",
            "texts": [
                "The wind up here does not just blow.\n",
                "It murders dreams.",
                "Old Caddy speaks wise words, though his bitterness clouds his vision.",
                "The Grandmaster is a fraud. And I have proof. ",
                "I am a member of the inner order who seeks to bring him down from the inside."
            ],
            "gaps": [
                1000,
                2000,
                1000,
                1000
            ],
            "duration": 1000
        },
        {
            "t": 75000,
            "speaker": "???",
            "text": "Take this.",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-rat.png",
            "portraitSide": "left",
            "duration": 1000,
            "texts": [
                "Take this.",
                "It is an item I call \"the Liquifier\".",
                "Once activated it will completely nullify the wind inside a localized bubble, giving you a fighting chance on your first three holes.",
                "I give it to you freely."
            ],
            "gaps": [
                1000,
                1000,
                1000
            ]
        },
        {
            "t": 89900,
            "speaker": "May",
            "text": "Freely?",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-may.png",
            "portraitSide": "left",
            "texts": [
                "Freely?",
                "What's the catch?"
            ],
            "gaps": [
                1000
            ],
            "duration": 1000
        },
        {
            "t": 94785,
            "speaker": "???",
            "text": "There is no catch.",
            "cps": 20,
            "duration": 1000,
            "texts": [
                "There is no catch.",
                "I've seen far too many young talents break on this mountain.",
                "And it's about time someone exposes the grandmaster as the fraud he is."
            ],
            "gaps": [
                2000,
                1000
            ],
            "portrait": "./img/cutscenes/portrait-rat.png",
            "portraitSide": "left"
        },
        {
            "t": 106500,
            "speaker": "May",
            "text": "Uhmm... thanks, I guess",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-may.png",
            "portraitSide": "left",
            "duration": 1000
        },
        {
            "t": 109000,
            "speaker": "???",
            "text": "Note that there are many other strange items on this mountain. Try to use them to your advantage.",
            "cps": 20,
            "duration": 1000,
            "texts": [
                "Note that there are many other strange items on this mountain. Try to use them to your advantage.",
                "Now, on your way to the 3-hole trial!"
            ],
            "gaps": [
                1500
            ],
            "portrait": "./img/cutscenes/portrait-rat.png",
            "portraitSide": "left"
        }
