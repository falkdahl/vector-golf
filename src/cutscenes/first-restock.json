    "dialogs": [
        {
            "t": 1500,
            "speaker": "Caddy",
            "text": "That Liquifier you gave us came in really clutch out there old man.",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-caddy.png",
            "portraitSide": "left",
            "texts": [
                "That Liquifier you gave us came in really clutch out there old man.",
                "What kind of devils magic is this?"
            ],
            "gaps": [
                1000
            ],
            "duration": 2000
        },
        {
            "t": null,
            "speaker": "???",
            "text": "It's not magic...",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-rat.png",
            "portraitSide": "left",
            "duration": 2000,
            "texts": [
                "It's not magic...",
                "It is strange technology developed by the most inner circle of the grandmaster.",
                "He runs a secret lab deep underground,",
                "led by a most annoying man called Dexter Brothman. ",
                "I have managed to get my hands of few more of their strange devices."
            ],
            "gaps": [
                1000,
                2000,
                1000,
                1000
            ],
            "auto": true
        },
        {
            "t": null,
            "speaker": "???",
            "text": "I call these the \"Deflector\", the \"Rotator\" and the \"Magnifier\".",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-rat.png",
            "portraitSide": "left",
            "duration": 1000,
            "texts": [
                "I call these the \"Deflector\", the \"Rotator\" and the \"Magnifier\".",
                "They will all manipulate the gale in different ways, use them wisely.",
                "the \"Deflector\" violently flips the wind in the opposite direction,",
                "the \"Rotator\" will twists it 90 degrees,",
                "and the \"Magnifier\" amplifies the gale to destructive levels.",
                "They were not easy for me to come by.",
                "I am afraid I can not give them away for free this time."
            ],
            "gaps": [
                1000,
                1000,
                1000,
                1000,
                1000,
                1000
            ],
            "auto": true
        },
        {
            "t": null,
            "speaker": "Caddy",
            "text": "Name your price, mystery man.",
            "cps": 20,
            "portrait": "./img/cutscenes/portrait-caddy.png",
            "portraitSide": "left",
            "duration": 1000,
            "auto": true,
            "texts": [
                "Name your price, mystery man.",
                "We're not turning back now. We smell blood, and the Grandmaster's throne is starting to wobble."
            ],
            "gaps": [
                1000
            ]
        }
