  "dialogs": [
    {
      "t": 1000,
      "speaker": "Grandmaster Cortex",
      "text": "Silence the winds in your hearts, brothers of the order!",
      "cps": 20,
      "portrait": "img/cutscenes/portrait-cortex.png",
      "portraitSide": "right",
      "texts": [
        "Silence the winds in your hearts, brothers of the order!",
        "For years, the uninitiated have mocked our sacred ways.",
        "They say golf is a game of calm greens and gentle breezes.",
        "Fools!",
        "Only in the fury of the gale does true skill reveal itself!",
        "The wind is our judge!",
        "The wind is our jury!",
        "It sweeps away the weak, leaving only the pure!",
        "Ten strokes per hole, or your ball is cast into the void forever.",
        "And remember the ancient edict: he who conquers all 18 holes of Mt. Aeolus shall be crowned Grandmaster in my stead!"
      ],
      "name": "grand master initial",
      "duration": 2000,
      "gaps": [
        1000,
        1000,
        1000,
        1000,
        1000,
        2000,
        2000,
        2000,
        1000
      ]
    },
    {
      "t": 42000,
      "speaker": "Slicer",
      "text": "And let it be known... ",
      "cps": 20,
      "portrait": "img/cutscenes/portrait-slicer.png",
      "portraitSide": "left",
      "texts": [
        "And let it be known... ",
        "those who try to cheat the wind...",
        "...or mock our traditions",
        "will face the wrath of the Slicer.",
        "And my swing leaves no divots",
        "only scars"
      ],
      "name": "slicer",
      "duration": 1500,
      "gaps": [
        1000,
        1500,
        1500,
        1500,
        1500
      ]
    },
    {
      "t": 59000,
      "speaker": "Grandmaster Cortex",
      "text": "Let the trials begin.",
      "cps": 20,
      "portrait": "img/cutscenes/portrait-cortex.png",
      "portraitSide": "right",
      "name": "master final",
      "texts": [
        "Let the trials begin.",
        "Find me a challenger worthy of my throne",
        "if they dare."
      ],
      "gaps": [
        1000,
        1000
      ],
      "duration": 2000
    }
