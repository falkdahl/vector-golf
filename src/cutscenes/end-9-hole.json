  "dialogs": [
    {
      "t": 2000,
      "speaker": "Caddy",
      "text": "You did it Kid!",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-caddy.png",
      "portraitSide": "left",
      "duration": 2000,
      "texts": [
        "You did it Kid!",
        "You tied the Grandmasters record run!"
      ],
      "gaps": [
        2000
      ]
    },
    {
      "t": null,
      "speaker": "Acolyte",
      "text": "She really did it...",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-acolyte.png",
      "portraitSide": "left",
      "auto": true,
      "duration": 1000,
      "texts": [
        "She really did it...",
        "can it be....",
        "...a new Grandmaster?!"
      ],
      "gaps": [
        1000,
        1000
      ]
    },
    {
      "t": null,
      "speaker": "May",
      "text": "I knew I had it in me!",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-may.png",
      "portraitSide": "left",
      "auto": true,
      "duration": 1500
    },
    {
      "t": 18700,
      "speaker": "Grandmaster Cortex",
      "text": "How can this be possible?!",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-cortex.png",
      "portraitSide": "left",
      "duration": 1500,
      "texts": [
        "How can this be possible?!",
        "No one can beat the 9-hole course, except ME!"
      ],
      "gaps": [
        1000
      ]
    },
    {
      "t": null,
      "speaker": "Slicer",
      "text": "They must have CHEATED master!",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-slicer.png",
      "portraitSide": "left",
      "auto": true,
      "duration": 1000
    },
    {
      "t": null,
      "speaker": "May",
      "text": "Do NOT call me a cheater!",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-may.png",
      "portraitSide": "left",
      "auto": true,
      "duration": 1500,
      "texts": [
        "Do NOT call me a cheater!",
        "Watch me as I finish the 18-hole course...",
        "and take the Grandmaster title from you."
      ],
      "gaps": [
        1000,
        1000
      ]
    },
    {
      "t": null,
      "speaker": "???",
      "text": "Ah... the voice of a sore loser.",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-rat.png",
      "portraitSide": "left",
      "auto": true,
      "texts": [
        "Ah... the voice of a sore loser.",
        "I see it has become part of your character Cortex."
      ],
      "gaps": [
        1000
      ],
      "duration": 1500
    },
    {
      "t": null,
      "speaker": "Grandmaster Cortex",
      "text": "And your obsession with my affairs suits you no better Ratko.",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-cortex.png",
      "portraitSide": "left",
      "auto": true,
      "duration": 1000,
      "texts": [
        "And your obsession with my affairs suits you no better Ratko.",
        "This is none of your business."
      ],
      "gaps": [
        1000
      ]
    },
    {
      "t": null,
      "speaker": "Caddy",
      "text": "You can save your applause for when we take first place.",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-caddy.png",
      "portraitSide": "left",
      "auto": true,
      "duration": 1500,
      "texts": [
        "You can save your applause for when we take first place.",
        "Come May...",
        "Let's go claim the victory everyone knows is ours."
      ],
      "gaps": [
        2000,
        1000
      ]
    }
