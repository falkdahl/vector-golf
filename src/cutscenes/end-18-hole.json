  "dialogs": [
    {
      "t": 2000,
      "speaker": "May",
      "text": "Eighteen! EIGHTEEN HOLES! Did you see that last ace, Caddy? Straight through the gale, no fear, no mercy!",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-may.webp",
      "portraitSide": "left",
      "duration": 2000
    },
    {
      "t": null,
      "speaker": "Caddy",
      "text": "Saw it, kid. Forty years lugging bags and I never seen anything like it. You made that wind carry you home.",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-caddy.webp",
      "portraitSide": "left",
      "auto": true,
      "duration": 2000
    },
    {
      "t": null,
      "speaker": "Acolyte",
      "text": "She really did it... all eighteen... no one ever has... is this... a new Grandmaster?!",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-acolyte.webp",
      "portraitSide": "left",
      "auto": true,
      "duration": 1500
    },
    {
      "t": null,
      "speaker": "???",
      "text": "Oh, they did it all right. Enjoy the applause while it lasts, heroes. The peak remembers everything.",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-rat.webp",
      "portraitSide": "left",
      "auto": true,
      "duration": 2000
    },
    {
      "t": null,
      "speaker": "Grandmaster Cortex",
      "text": "SILENCE! This is impossible! No one conquers all eighteen! No one shames ME before the Order!",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-cortex.webp",
      "portraitSide": "right",
      "auto": true,
      "duration": 2000
    },
    {
      "t": null,
      "speaker": "Slicer",
      "text": "Outta my way, girlie. What's this? More pocket weather crimes? Hand 'em over, cheaters!",
      "cps": 20,
      "portrait": "./img/cutscenes/portrait-slicer.webp",
      "portraitSide": "right",
      "auto": true,
      "duration": 2000
    },
    {
